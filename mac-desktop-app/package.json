{
  "name": "nodetelehealth-marketing",
  "productName": "NodeTelehealth Marketing",
  "version": "1.0.0",
  "description": "Marketing automation control center for NodeTelehealth.com (Florida telehealth).",
  "author": "NodeTelehealth",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev:backend": "node ../gas-backend/dev/serve.js --demo",
    "test:backend": "node ../gas-backend/dev/smoke-test.js",
    "icons": "node scripts/make-icons.js",
    "build:mac": "electron-builder --mac dmg --arm64 --x64",
    "build:mac:universal": "electron-builder --mac dmg --universal",
    "pack": "electron-builder --mac --dir"
  },
  "dependencies": {
    "chart.js": "^4.6.1"
  },
  "devDependencies": {
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.nodetelehealth.marketing",
    "productName": "NodeTelehealth Marketing",
    "copyright": "Copyright © NodeTelehealth",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "styles.css",
      "renderer.js",
      "assets/**/*",
      "node_modules/chart.js/dist/chart.umd.min.js"
    ],
    "mac": {
      "category": "public.app-category.business",
      "icon": "build/icon.png",
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "NodeTelehealth Marketing ${version}",
      "artifactName": "NodeTelehealth-Marketing-${version}-${arch}.${ext}",
      "contents": [
        {
          "x": 150,
          "y": 190
        },
        {
          "x": 390,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
